# ============================================
# APP CONFIGURATION
# ============================================
APP_ENV=development
APP_NAME=HealthMind AI
APP_VERSION=1.0.0
APP_SECRET_KEY=replace-with-secure-random-value
APP_DEBUG=true

# ============================================
# DATABASE
# ============================================
# Local development: self-contained SQLite (no server or password needed).
# The file `healthmind.db` is created in the backend/ directory automatically.
DATABASE_URL=sqlite+aiosqlite:///./healthmind.db
# Production/PostgreSQL (Docker Compose):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/healthmind
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30

# ============================================
# REDIS
# ============================================
# Local Redis (install/run redis-server or use the Docker Compose stack)
REDIS_URL=redis://localhost:6379/0
# Docker Compose variant:
# REDIS_URL=redis://redis:6379/0
REDIS_DB=0

# ============================================
# JWT AUTHENTICATION
# ============================================
JWT_SECRET_KEY=replace-with-secure-random-value
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# ============================================
# GEMINI AI
# ============================================
# GET FROM: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=replace-with-your-google-gemini-api-key
GEMINI_MODEL=gemini-1.5-pro
GEMINI_MAX_TOKENS=2048
GEMINI_TEMPERATURE=0.7

# ============================================
# FIREBASE CLOUD MESSAGING
# ============================================
# GET FROM: https://console.firebase.google.com/
# Download service account JSON (the bundled file is firebase-credentials.json)
FIREBASE_CREDENTIALS=./firebase-credentials.json

# ============================================
# CORS
# ============================================
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173,https://yourdomain.com
FRONTEND_URL=http://localhost:8000

# ============================================
# GOOGLE OAUTH
# ============================================
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/oauth/google/callback

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_AI_PER_MINUTE=20
RATE_LIMIT_EMERGENCY_PER_MINUTE=3

# ============================================
# CELERY (Background Tasks)
# ============================================
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=INFO
LOG_JSON=false

# ============================================
# SECURITY
# ============================================
BCRYPT_ROUNDS=12

# ============================================
# PAGINATION
# ============================================
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# ============================================
# SUPABASE
# ============================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_PUBLISHABLE_KEY=sb_publishable_gGvvv2dTRGG_zdorYZzYpg_0uVg-PJ7

# ============================================
# EMAIL (for password reset, notifications)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=no-reply@healthmind.ai
