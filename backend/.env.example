# ============================================
# APP CONFIGURATION
# ============================================
APP_ENV=development
APP_NAME=HealthMind AI
APP_VERSION=1.0.0
APP_DEBUG=true

# ============================================
# DATABASE (Supabase Postgres — the only supported database)
# ============================================
# From Supabase: Settings -> Database -> Connection string, asyncpg driver.
# Direct connection:
DATABASE_URL=postgresql+asyncpg://postgres:<db-password>@db.<project-ref>.supabase.co:5432/postgres
# Or the pooled/transaction-mode variant (recommended for serverless/many
# short-lived connections — a normal always-on backend like this one doesn't
# need it, but it works the same either way):
# DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30

# ============================================
# REDIS (rate limiting, Celery)
# ============================================
REDIS_URL=redis://localhost:6379/0
# Docker Compose variant:
# REDIS_URL=redis://redis:6379/0
REDIS_DB=0

# ============================================
# GEMINI AI
# ============================================
# GET FROM: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=replace-with-your-google-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MAX_TOKENS=2048
GEMINI_TEMPERATURE=0.7

# ============================================
# CORS
# ============================================
# List only origins you actually serve the frontend from — don't ship a dev
# localhost entry alongside your real domain in production.
FRONTEND_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
FRONTEND_URL=http://localhost:8000

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_AI_PER_MINUTE=20
RATE_LIMIT_EMERGENCY_PER_MINUTE=3

# ============================================
# CELERY (Background Tasks)
# ============================================
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=INFO
LOG_JSON=false

# ============================================
# PAGINATION
# ============================================
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# ============================================
# SUPABASE (Settings -> API in your project dashboard)
# ============================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key
# No JWT secret needed here — see app/core/security.py. Projects on the
# newer asymmetric signing keys (Settings -> API -> JWT Settings shows a
# "Key ID" / ECC or RSA type, not a copyable secret) are verified against
# the project's public JWKS at runtime instead.

# ============================================
# EMAIL (emergency alerts only — signup/reset emails are sent by Supabase)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=no-reply@healthmind.ai
EMERGENCY_RECIPIENT=

# ============================================
# UPLOADS
# ============================================
STORAGE_DIR=./storage/medical_records
MAX_UPLOAD_SIZE_MB=10

# ============================================
# n8n Care Orchestrator (optional)
# ============================================
# Production webhook URL from your n8n workflow. Leave empty to disable.
N8N_WEBHOOK_URL=
# Shared secret; n8n should verify header X-HealthMind-Signature: sha256=<hmac>
N8N_WEBHOOK_SECRET=

