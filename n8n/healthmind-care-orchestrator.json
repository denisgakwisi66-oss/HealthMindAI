    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst raw = typeof $input.first().json === 'string'\n  ? $input.first().json\n  : JSON.stringify($input.first().json);\nconst headers = $input.first().json.headers || {};\nconst signature = headers['x-healthmind-signature'] || headers['X-HealthMind-Signature'] || '';\nconst secret = $env.HEALTHMIND_WEBHOOK_SECRET || '';\n\nlet body = $input.first().json.body || $input.first().json;\nif (body.body) body = body.body;\nif (typeof body === 'string') {\n  try { body = JSON.parse(body); } catch (e) {}\n}\n\nif (secret) {\n  const expected = 'sha256=' + crypto.createHmac('sha256', secret).update(\n    typeof $input.first().json.rawBody === 'string' ? $input.first().json.rawBody : JSON.stringify(body)\n  ).digest('hex');\n  // Soft-verify: log mismatch but still continue in demo mode if VERIFY_STRICT !== '1'\n  if (signature && signature !== expected && $env.HEALTHMIND_VERIFY_STRICT === '1') {\n    throw new Error('Invalid X-HealthMind-Signature');\n  }\n}\n\nreturn [{\n  json: {\n    event: body.event || headers['x-healthmind-event'] || 'unknown',\n    timestamp: body.timestamp,\n    source: body.source || 'healthmind-ai',\n    data: body.data || body,\n  }\n}];"
      },
