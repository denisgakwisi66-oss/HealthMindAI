# ============================================
# HealthMind AI - root .gitignore
# ============================================

# --- Python ---
node_modules/
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/

# --- Environment & secrets (never commit) ---
.env
.env.*
!.env.example
.env.local
*.pem
**/firebase-credentials.json
**/*firebase-adminsdk*.json
**/service-account*.json
**/*service_account*.json
**/credentials*.json

# --- Databases ---
*.db
*.db-journal
test_*.db
*.sqlite3

# --- Logs ---
*.log

# --- OS / editor ---
.DS_Store
Thumbs.db
.vscode/

# --- Debug / scratch artifacts at repo root ---
/*.txt
/*.exe
/*.ps1
/*.bat
HealthMindAI/
www/
android/.gradle/
android/local.properties
android/app/build/
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
ios/App/Pods/
ios/App/DerivedData/
ios/App/App/public/
ios/App/App/capacitor.config.json

# local n8n secret helper
n8n/.last-generated-secret.txt
